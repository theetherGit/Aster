---
/**
 * Shot — a real screenshot of the app, from src/assets/shots/ (written by the root's
 * tests/e2e/docs-shots.spec.ts). Shows the light or dark capture with the docs' theme; a shot with
 * only one capture (the Classic layout, high contrast) shows it in both. Captured at 2×, so it is
 * drawn at half its pixel width and never stretched past it.
 *
 *   <Shot name="chip" alt="…" />
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  name: string;
  alt: string;
  caption?: string;
  /** Above the fold: load at once rather than when scrolled to. */
  eager?: boolean;
}
const { name, alt, caption, eager } = Astro.props;
const all = import.meta.glob<{ default: ImageMetadata }>("../assets/shots/*.png", { eager: true });
const light = all[`../assets/shots/${name}-light.png`]?.default;
const dark = all[`../assets/shots/${name}-dark.png`]?.default;
if (!light) throw new Error(`Shot: no src/assets/shots/${name}-light.png`);
const width = Math.round(light.width / 2);
const loading = eager ? "eager" : "lazy";
---

<figure class="shot not-prose" style={`max-width: min(100%, ${width}px)`}>
  <Image src={light} alt={alt} width={width} densities={[1, 2]} loading={loading} class={dark ? "shot-light" : undefined} />
  {dark && <Image src={dark} alt={alt} width={width} densities={[1, 2]} loading={loading} class="shot-dark" />}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot {
    margin: 1.75rem 0;
  }
  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--nb-border);
    border-radius: var(--nb-radius-card);
  }
  .shot :global(img.shot-dark) {
    display: none;
  }
  :global([data-mode="dark"]) .shot :global(img.shot-light) {
    display: none;
  }
  :global([data-mode="dark"]) .shot :global(img.shot-dark) {
    display: block;
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--nb-muted-foreground);
  }
</style>
