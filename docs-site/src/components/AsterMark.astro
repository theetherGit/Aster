---
/**
 * The Aster mark (docs/brand/aster-mark.svg): six petals around the amber centre. The petals take
 * the theme's violet, so one SVG is the light mark and the dark one. Decorative beside the
 * wordmark; pass `label` when it stands alone.
 */
interface Props {
  class?: string;
  label?: string;
}
const { class: className, label } = Astro.props;
const petals = [0, 60, 120, 180, 240, 300];
---

<svg
  viewBox="0 0 100 100"
  class={className}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  <g fill="var(--nb-link)">
    {petals.map((deg) => <rect x="43" y="4" width="14" height="38" rx="7" transform={`rotate(${deg} 50 50)`} />)}
  </g>
  <circle cx="50" cy="50" r="11" fill="var(--nb-highlight)" />
</svg>
