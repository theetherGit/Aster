---
interface Props {
  /** Absolute or site-relative URL for this page's markdown version, or
   *  `null` when the page has no per-page Markdown (a non-default
   *  query-mode API version) — the directive then points at the index only. */
  markdownUrl?: string | null;
  /** Absolute or site-relative URL for the top-level llms.txt index. */
  llmsUrl: string;
}

const { markdownUrl, llmsUrl } = Astro.props;
---

<!-- For agents that read the HTML. Out of the Tab order and away from screen readers: a visually
     hidden link that takes focus leaves keyboard users with no visible focus (WCAG 2.4.7). -->
<aside class="sr-only" aria-hidden="true" data-ai-agent-directive>
  {markdownUrl ? (
    <Fragment>
      This page is available in Markdown format. Markdown is recommended for AI
      consumption. See <a href={markdownUrl} tabindex="-1">{markdownUrl}</a> for this page, or
      <a href={llmsUrl} tabindex="-1">{llmsUrl}</a> for the full documentation index.
    </Fragment>
  ) : (
    <Fragment>
      See <a href={llmsUrl} tabindex="-1">{llmsUrl}</a> for the full documentation index.
      Markdown is recommended for AI consumption.
    </Fragment>
  )}
</aside>
