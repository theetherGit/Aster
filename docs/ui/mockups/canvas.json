		"n1": {
			"x": 2720,
			"y": 2080,
			"w": 480,
			"text": "Every app board is Main.dc.html with preset tweaks: layout (modern/classic), theme, panel state, overlay, inspector, text view, focus nav, contrast. The canvas content — the same Library diagram — is shared, so a notation change shows up on all of them at once. The notation sheet (12) is its own file.",
			"fill": "blue"
		},
		"n2": {
			"x": 2720,
			"y": 2500,
			"w": 480,
			"text": "Decisions: paper stays white in every theme (UML is read on white); only selection, focus and connection previews use the accent on the paper; Classic uses StarUML's pale-yellow class fill and a line grid, Modern uses white fill and a dot grid.",
			"fill": "gray"
		},
		"n3": {
			"x": 4080,
			"y": 3120,
			"w": 480,
			"text": "Focus (dashed ring, Book) is distinct from selection (solid outline, Loan). The narration bar is the aria-live region made visible for the mockup; in the app it is visually hidden unless the user turns on captions. High contrast: 2 px ink, yellow accent, black-on-yellow for primary buttons.",
			"fill": "gray"
		}
	},
